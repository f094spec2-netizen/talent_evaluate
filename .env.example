APP_ENV=development
DATABASE_URL=sqlite:///./data/private/talent.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/private/objects
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# JSON mapping. Real Telegram IDs and company assignments belong only in .env / Railway.
TELEGRAM_ACCOUNTS={}
# Example shape: {"123456":{"company_code":"DEMO","officer_code":"OFFICER01"}}
MAX_UPLOAD_BYTES=20000000
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
